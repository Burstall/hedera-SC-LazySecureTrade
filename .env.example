# ============================================================
# Operator account (required for ALL scripts and tests)
# ============================================================
# Environment: test, main, preview, or local [case-insensitive]
ENVIRONMENT=test
ACCOUNT_ID=
PRIVATE_KEY=

# ============================================================
# Reusable test accounts (gate fresh creation in test/*.test.js)
# Tests check these env vars and reuse the account if present;
# otherwise they create a fresh account and log its ID + key.
# Cache the printed values here to skip ~600 HBAR/run of provisioning.
# ============================================================
# Alice — seller / NFT holder (LST + BCF tests)
#ALICE_ACCOUNT_ID=
#ALICE_PRIVATE_KEY=
# Bob — buyer (LST) / bidder + stash owner (BCF)
#BOB_ACCOUNT_ID=
#BOB_PRIVATE_KEY=
# Charlie — delegated holder (LST v0.2 tests only)
#CHARLIE_ACCOUNT_ID=
#CHARLIE_PRIVATE_KEY=
# Carol — third-party arbitrageur (BCF v0.3 tests only)
#CAROL_ACCOUNT_ID=
#CAROL_PRIVATE_KEY=

# ============================================================
# v0.2 LazySecureTrade core (deploy parameters)
# ============================================================
LAZY_COST_FOR_TRADE=500
LAZY_BURN_PERCENT=50
# Token decimals — tests default to 1 if unset
LAZY_DECIMALS=1
# Max supply for the test-deployed $LAZY token
LAZY_MAX_SUPPLY=250000000

# ============================================================
# v0.2 deployed contract reuse (uncomment to skip redeployment)
# These are read by tests + deploy scripts on the network selected
# by ENVIRONMENT above. The event-scanner config is separate (see
# the scanner section near the bottom of this file).
# ============================================================
#LAZY_TOKEN_ID=0.0.1311037
#LAZY_SCT_CONTRACT_ID=0.0.1311003
#LAZY_GAS_STATION_CONTRACT_ID=0.0.7221483
#LAZY_DELEGATE_REGISTRY_CONTRACT_ID=0.0.7221486
#LSH_GEN1_TOKEN_ID=0.0.768753
#LSH_GEN2_TOKEN_ID=0.0.848553
#LSH_GEN1_MUTANT_TOKEN_ID=0.0.1693200
#LAZY_SECURE_TRADE_CONTRACT_ID=
# LazyDelegateRegistry test wrapper contract (LazyDelegateRegistry.test.js only)
#LDA_TESTER_CONTRACT_ID=

# ============================================================
# v0.3 BidderContractFactory deployed contract reuse
# ============================================================
#BIDDER_IMPL_CONTRACT_ID=0.0.XXXXXXX
#BIDDER_FACTORY_CONTRACT_ID=0.0.XXXXXXX

# v0.3 BCF NFT test collection (gate in BidderContractFactory.test.js)
# Set BOTH together — the supply key is needed to mint additional serials.
#BCF_NFT_TOKEN_ID=0.0.XXXXXXX
#BCF_NFT_SUPPLY_KEY=

# v0.3 Factory multisig (after running setupFactoryMultisig.js)
#FACTORY_MULTISIG_ACCOUNT_ID=0.0.XXXXXXX
#FACTORY_MULTISIG_THRESHOLD=2

# ============================================================
# Tuning
# ============================================================
# Sleep duration in ms between state-change and mirror-node read.
# Default 5000 in solidityHelpers.js; BCF.test.js hardcodes 5500.
# Raise if you see flaky mirror reads.
#SLEEP_TIME=5000

# ============================================================
# scoopTestHbar.js — sweep HBAR from arbitrary accounts
# ============================================================
# Comma-separated account IDs and matching ED25519 private keys.
#SCOOP_ACCOUNTS=0.0.XXX,0.0.YYY
#SCOOP_KEYS=302e...,302e...

# ============================================================
# Directus event scanner backend
# ============================================================
# The scanner's network and contract are separate from the test
# ENVIRONMENT + LAZY_SECURE_TRADE_CONTRACT_ID above. This lets you
# run testnet integration tests while the scanner watches mainnet,
# without the two configs colliding.
#
# Canonical scanner var: SECURE_TRADE_CONTRACT_ID
# (legacy LAZY_SECURE_TRADE_CONTRACT_ID is still accepted as a
#  fallback with a deprecation warning)
SECURE_TRADE_CONTRACT_ID=0.0.7540226
SECURE_TRADE_ENV=mainnet
SECURE_TRADE_EVENTS_TABLE=secureTradeEvents
SECURE_TRADE_CACHE_TABLE=SecureTradesCache
SECURE_TRADE_SUPRESS_LOGS=0

# v0.3 Factory event scanner (bidderFactoryEventScanner.js)
# The scanner reads BIDDER_FACTORY_CONTRACT_ID directly. If you need
# the scanner to watch a DIFFERENT factory than your tests reuse, pass
# the contract ID as a CLI arg instead.
BIDDER_FACTORY_EVENTS_TABLE=bidderFactoryEvents
BIDDER_BIDS_CACHE_TABLE=bidderBidsCache
BIDDER_STASH_EVENTS_TABLE=bidderStashEvents

# Directus connection
DIRECTUS_DB_URL=
DIRECTUS_TOKEN=
